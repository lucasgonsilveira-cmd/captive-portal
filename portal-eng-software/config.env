# ==========================================================
#  Configurações do portal  (pode editar; salve e rode de novo)
# ==========================================================

# Nome da rede Wi-Fi aberta que vai aparecer nos celulares
SSID="Eng-Software"

# Quantos aparelhos podem ter internet de verdade
MAX_CLIENTES=10

# Rede do portal: o notebook vira o ".1" desta faixa (ex.: 10.77.0.1).
# O script troca sozinho se a faixa já estiver em uso pelo celular.
REDE_BASE="10.77.0"

# DNS usado por quem já foi liberado
DNS_REAL="8.8.8.8"

# Porta do portal (80 é a normal; precisa estar livre no notebook)
PORTAL_PORT=80
